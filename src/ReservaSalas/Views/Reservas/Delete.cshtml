
@model ReservaSalas.Models.Reserva

@{
    ViewData["Title"] = "Cancelar Reserva";
}

<h1>Cancelar Reserva</h1>

<h4 class="text-danger">
    Tem a certeza de que pretende cancelar esta reserva?
</h4>

<hr />

<div class="mb-4">
    <dl class="row">
        <dt class="col-sm-3">Sala</dt>
        <dd class="col-sm-9">@Model.Sala.Codigo</dd>

        <dt class="col-sm-3">Docente</dt>
        <dd class="col-sm-9">@Model.Docente.Nome</dd>

        <dt class="col-sm-3">Data</dt>
        <dd class="col-sm-9">@Model.Data.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3">Hora de início</dt>
        <dd class="col-sm-9">@Model.HoraInicio.ToString("HH:mm")</dd>

        <dt class="col-sm-3">Hora de fim</dt>
        <dd class="col-sm-9">@Model.HoraFim.ToString("HH:mm")</dd>

        <dt class="col-sm-3">Finalidade</dt>
        <dd class="col-sm-9">@Model.Finalidade</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Confirmar Cancelamento
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Voltar
    </a>
</form>
