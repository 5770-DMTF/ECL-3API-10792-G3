
@model IEnumerable<ReservaSalas.Models.Reserva>

@{
    ViewData["Title"] = "Reservas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Reservas</h1>

    <a asp-action="Create" class="btn btn-primary">
        Nova Reserva
    </a>
</div>

<form asp-action="Index" method="get" class="card card-body mb-4">
    <h5 class="mb-3">Filtrar Reservas</h5>

    <div class="row g-3">

        <div class="col-md-4">
            <label class="form-label">Sala</label>
            <select name="salaId"
                    asp-items="ViewBag.Salas"
                    class="form-select">
                <option value="">Todas as salas</option>
            </select>
        </div>

        <div class="col-md-4">
            <label class="form-label">Docente</label>
            <select name="docenteId"
                    asp-items="ViewBag.Docentes"
                    class="form-select">
                <option value="">Todos os docentes</option>
            </select>
        </div>

        <div class="col-md-4">
            <label class="form-label">Data</label>
            <input type="date"
                   name="data"
                   value="@ViewBag.DataFiltro"
                   class="form-control" />
        </div>

    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">
            Filtrar
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Limpar filtros
        </a>
    </div>
</form>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Sala</th>
            <th>Docente</th>
            <th>Data</th>
            <th>Hora de Início</th>
            <th>Hora de Fim</th>
            <th>Finalidade</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var reserva in Model)
        {
            <tr>
                <td>@reserva.Sala.Codigo</td>
                <td>@reserva.Docente.Nome</td>
                <td>@reserva.Data.ToString("dd/MM/yyyy")</td>
                <td>@reserva.HoraInicio.ToString("HH:mm")</td>
                <td>@reserva.HoraFim.ToString("HH:mm")</td>
                <td>@reserva.Finalidade</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@reserva.Id"
                       class="btn btn-sm btn-warning">Editar</a>

                    <a asp-action="Delete" asp-route-id="@reserva.Id"
                       class="btn btn-sm btn-danger">Cancelar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
