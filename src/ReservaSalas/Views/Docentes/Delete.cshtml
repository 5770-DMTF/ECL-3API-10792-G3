
@model ReservaSalas.Models.Docente

@{
    ViewData["Title"] = "Eliminar Docente";
}

<h1>Eliminar Docente</h1>

<h4>Tem a certeza de que pretende eliminar este docente?</h4>

<hr />

<div>
    <dl class="row">
        <dt class="col-sm-3">Nome</dt>
        <dd class="col-sm-9">@Model.Nome</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>

        <dt class="col-sm-3">Área</dt>
        <dd class="col-sm-9">@Model.Area</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">
            Confirmar eliminação
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancelar
        </a>
    </form>
</div>
