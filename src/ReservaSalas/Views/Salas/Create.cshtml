
@model ReservaSalas.Models.Sala

@{
    ViewData["Title"] = "Adicionar Sala";
}

<h1>Adicionar Sala</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Codigo" class="form-label">
                    Código
                </label>
                <input asp-for="Codigo" class="form-control" />
                <span asp-validation-for="Codigo"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Capacidade" class="form-label">
                    Capacidade
                </label>
                <input asp-for="Capacidade"
                       type="number"
                       min="1"
                       class="form-control" />
                <span asp-validation-for="Capacidade"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Tipo" class="form-label">
                    Tipo
                </label>
                <input asp-for="Tipo" class="form-control" />
                <span asp-validation-for="Tipo"
                      class="text-danger"></span>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">
                    Guardar
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Voltar
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}